# Всё в этом репозитории исполняется на Linux.
# Без принудительного LF винда подсунет CRLF, и bash упадёт на шебанге:
#   bash: ./install.sh: /bin/bash^M: bad interpreter
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.rules     text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
bin/hivelink            text eol=lf
sbin/hivelink-reconcile text eol=lf
