# hivelink — реакция на появление модема.
#
# Из udev не запускаем долгую работу напрямую: правило только дёргает
# systemd-юнит, а весь цикл идёт под общей блокировкой. Это переживает
# «шторм» hotplug-событий, когда партию втыкают целиком.

# Сразу гасим энергосбережение — autosuspend на модеме даёт случайные обрывы.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="12d1", \
    TEST=="power/control", ATTR{power/control}="on"

# И на ХАБАХ тоже. Уснувший хаб утаскивает всю ветку разом: модемы под ним
# просто исчезают, и это выглядит как отказ железа.
ACTION=="add", SUBSYSTEM=="usb", ATTR{bDeviceClass}=="09", \
    TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTR{bDeviceClass}=="09", \
    TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# Появилось устройство нужного вендора — просим systemd прогнать цикл.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="12d1", ATTR{bDeviceClass}!="09", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="hivelink-reconcile.service"

# Появился сетевой интерфейс на модемном драйвере — тоже повод свериться.
ACTION=="add", SUBSYSTEM=="net", DRIVERS=="rndis_host|cdc_ether|cdc_ncm|huawei_cdc_ncm", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="hivelink-reconcile.service"

# Модем выдернули — состояние подчистит следующий цикл по таймеру.
ACTION=="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="12d1", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="hivelink-reconcile.service"
