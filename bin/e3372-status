#!/usr/bin/env bash
# =============================================================================
#  e3372-status — состояние парка одной таблицей.
#    --no-exit   не проверять внешний IP (быстро)
#    --json      машинночитаемый вывод
# =============================================================================
set -uo pipefail
# shellcheck source=../lib/common.sh
. /usr/local/lib/e3372/common.sh

CHECK_EXIT=1; JSON=0
for a in "$@"; do
    case "$a" in
        --no-exit) CHECK_EXIT=0 ;;
        --json)    JSON=1 ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    esac
done

probe_one() {
    local iface="$1" ipaddr="$2" n gw drv port cfg ses sid tok st ds cs sw net exitip err
    n=$(printf '%s' "$ipaddr" | cut -d. -f3)
    gw="$HOST_PREFIX.$n.$GW_OCTET"
    drv=$(iface_driver "$iface"); drv=${drv:-—}
    port=$(iface_usb_port "$iface") || port=—
    cfg="—"
    if [ -d "/sys/bus/usb/devices/$port" ]; then
        cfg="$(dev_attr "/sys/bus/usb/devices/$port" bConfigurationValue)/$(dev_attr "/sys/bus/usb/devices/$port" bNumConfigurations)"
    fi
    ses=$(hl_session "$gw") && { sid=${ses%%|*}; tok=${ses##*|}; } || { sid=x; tok=x; }
    st=$(hl_get "$gw" "$sid" "$tok" /api/monitoring/status)
    ds=$(hl_get "$gw" "$sid" "$tok" /api/dialup/mobile-dataswitch)
    cs=$(printf '%s' "$st" | xmlval ConnectionStatus)
    net=$(printf '%s' "$st" | xmlval CurrentNetworkType)
    sw=$(printf '%s' "$ds" | xmlval dataswitch); sw=${sw:-?}
    err=$(printf '%s' "$st" | xmlval code)
    [ -z "$cs" ] && [ -n "$err" ] && cs="api$err"
    exitip="—"
    if [ "$CHECK_EXIT" = 1 ]; then
        exitip=$(curl --interface "$ipaddr" -s -m8 https://ip.me 2>/dev/null | tr -d '\r\n' | head -c 45)
        case "$exitip" in ''|*'<'*) exitip="—" ;; esac
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$n" "$iface" "$drv" "$cfg" "$(conn_text "$cs")" "$sw" "$(net_text "$net")" "$exitip"
}

TMP=$(mktemp) || exit 1
trap 'rm -f "$TMP"' EXIT
modem_ips | while read -r iface ipaddr; do probe_one "$iface" "$ipaddr"; done | sort -n > "$TMP"

if [ "$JSON" = 1 ]; then
    printf '[\n'
    awk -F'\t' 'BEGIN{first=1}
        { if(!first) printf ",\n"; first=0
          printf "  {\"n\":%s,\"iface\":\"%s\",\"driver\":\"%s\",\"cfg\":\"%s\",\"conn\":\"%s\",\"dataswitch\":\"%s\",\"net\":\"%s\",\"exit_ip\":\"%s\"}", $1,$2,$3,$4,$5,$6,$7,$8 }
        END{ printf "\n" }' "$TMP"
    printf ']\n'
    exit 0
fi

# --- сводка по USB (в т.ч. модемы, до которых сеть ещё не дошла) -------------
tot=0; cdrom=0; stick=0; hil=0
while read -r d; do
    pid=$(dev_attr "$d" idProduct); [ -n "$pid" ] || continue
    tot=$(( tot + 1 ))
    case "$(pid_mode "$pid")" in
        cdrom) cdrom=$(( cdrom + 1 )) ;;
        stick|stick-serial) stick=$(( stick + 1 )) ;;
        hilink) hil=$(( hil + 1 )) ;;
    esac
done < <(usb_devs)
withip=$(wc -l < "$TMP" | tr -d ' ')

printf '== USB Huawei: %s шт. | hilink %s | Zero-CD %s | stick %s | с адресом %s ==\n' \
       "$tot" "$hil" "$cdrom" "$stick" "$withip"
printf '%-4s %-16s %-12s %-5s %-15s %-6s %-5s %s\n' N IFACE DRIVER CFG CONN DATASW NET EXIT-IP
awk -F'\t' '{ printf "%-4s %-16s %-12s %-5s %-15s %-6s %-5s %s\n", $1,$2,$3,$4,$5,$6,$7,$8 }' "$TMP"

bad=$(awk -F'\t' '$5!="онлайн"' "$TMP" | wc -l | tr -d ' ')
[ "$bad" != 0 ] && printf '\n  %s модем(ов) не онлайн — journalctl -t e3372 -n 50\n' "$bad"
[ "$cdrom" != 0 ] && printf '  %s в Zero-CD — переключение идёт, следующий цикл через ~15с\n' "$cdrom"
[ "$stick" != 0 ] && printf '  %s в stick-режиме — нужна HiLink-прошивка, хостом не лечится\n' "$stick"
exit 0
