#!/bin/bash
# hivelink-reconcile — один полный цикл приведения модемов в рабочее состояние.
#
# Идемпотентен: гоняется по таймеру и по udev-событию, ничего не ломает
# повторным запуском. Всё, что не удалось, попадает в лог и в снимок статуса.
#
# Устроен в три фазы, потому что модемов может быть под три сотни:
#   1. последовательно и быстро — раздача номеров (пишет общий файл)
#   2. параллельно            — стадии по каждому модему (тут все таймауты)
#   3. последовательно        — сборка результатов и уборка мусора
#
#   hivelink-reconcile [--slot N] [--verbose] [--no-recover] [--full]

set -uo pipefail

HL_LIB="${HL_LIB:-/opt/hivelink/lib}"
. "$HL_LIB/common.sh"
. "$HL_LIB/usb.sh"
. "$HL_LIB/net.sh"
. "$HL_LIB/hilink.sh"
. "$HL_LIB/health.sh"

ONLY_SLOT=""
DO_RECOVER=1
FORCE_HEALTH=0

while [ $# -gt 0 ]; do
    case "$1" in
        --slot)        ONLY_SLOT="$2"; shift 2 ;;
        --verbose|-v)  HL_LOG_LEVEL=debug; _HL_LVL=10; _HL_ERR=1; shift ;;
        --no-recover)  DO_RECOVER=0; shift ;;
        --full)        FORCE_HEALTH=1; shift ;;
        -h|--help)     sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)             err "неизвестный аргумент: $1"; exit 2 ;;
    esac
done

[ "$(id -u)" = 0 ] || die "нужен root"

hl_state_init
hl_lock reconcile 60

WORKDIR="$HL_RUN/w"
rm -rf "$WORKDIR"; mkdir -p "$WORKDIR"
SNAP="$HL_RUN/status.tsv"
NOW=$(date +%s)

hl_sysctl_apply
hl_dns_guard || true
hl_rules_cache
hl_usbfs_tune
hl_disable_hub_autosuspend
hl_networkd_dropin

# ============================================================ фаза 1 ========
# Раздача номеров идёт строго последовательно: она пишет общую карту слотов,
# и параллельный доступ к ней породил бы двух модемов с одним адресом.

DEVS=()
while read -r port vid pid bcd; do
    [ -n "$port" ] || continue
    # Без подстановки $(...): она создаёт подоболочку, и обновления карты
    # слотов в памяти не дожили бы до следующей итерации — все модемы
    # цикла получили бы один и тот же номер.
    hl_slot_for_port "$port" >/dev/null || continue
    slot="$HL_SLOT"
    [ -n "$slot" ] || continue
    [ -n "$ONLY_SLOT" ] && [ "$slot" != "$ONLY_SLOT" ] && continue
    DEVS+=("$port|$vid|$pid|$bcd|$slot")
done <<<"$(hl_usb_devices)"

TOTAL=${#DEVS[@]}
if [ "$TOTAL" = 0 ]; then
    warn "модемов не найдено (искал вендоров: $HL_VENDORS)"
    : >"$SNAP"; date +%s >"$HL_RUN/last-run"
    exit 0
fi

# ============================================================ фаза 2 ========
# Стадии по каждому модему. Здесь живут все дорогие операции: sleep после
# modeswitch, пинги, запросы к веб-API. Отсюда и параллельность.

worker() {
    local spec="$1"
    local port vid pid bcd slot
    IFS='|' read -r port vid pid bcd slot <<<"$spec"

    local iface_want out="$WORKDIR/$slot"
    iface_want=$(hl_iface "$slot")
    report() { printf '%s\t%s\t%s\t%s\t%s\n' "$slot" "$port" "${3:--}" "$1" "$2" >"$out"; }

    hl_disable_autosuspend "$port"

    # ---- стадия 1: Zero-CD
    if hl_is_zerocd "$pid"; then
        hl_modeswitch "$port" "$vid" "$pid" || { report zerocd "не переключился"; return; }
        pid=$(hl_dev_attr "$port" idProduct)
    fi

    # ---- стадия 2: драйвер и USB-конфигурация
    local family want_drv have_drv model="$pid:$bcd"
    read -r family want_drv <<<"$(hl_registry_lookup "$vid" "$pid")"
    [ "$HL_PREFER_DRIVER" != auto ] && want_drv="$HL_PREFER_DRIVER"
    hl_confmap_set "drv:$model" "$want_drv"

    have_drv=$(hl_driver_of_port "$port" 2>/dev/null || echo "")
    if [ -z "$have_drv" ]; then
        # Устройство могло только что появиться и ещё не привязать драйвер.
        # Дёргать его в этот момент — гарантированно сломать привязку,
        # поэтому сначала выжидаем несколько циклов.
        local g; g=$(hl_cnt_bump nodrv "$port")
        if [ "$g" -le "${HL_NODRV_GRACE:-3}" ]; then
            dbg "$port: драйвер ещё не привязан, жду ($g/${HL_NODRV_GRACE:-3})"
            report wait "жду привязки драйвера ($g/${HL_NODRV_GRACE:-3})"
            return
        fi
        # Ядро могло сесть не на ту конфигурацию: у HiLink это обычно
        # NCM-вариант, дающий wwanN без DHCP вместо ethN.
        hl_cfg_probe "$port" "$model" || hl_rebind "$port"
        have_drv=$(hl_driver_of_port "$port" 2>/dev/null || echo "")
    fi
    [ -z "$have_drv" ] && { report nodrv "нет драйвера ($vid:$pid)"; return; }
    hl_cnt_clear nodrv "$port"

    # ---- стадия 3: имя интерфейса
    local iface
    iface=$(hl_netdev_of_port "$port") || { report noif "интерфейс не найден"; return; }
    if [ "$iface" != "$iface_want" ] && [ "${HL_RENAME_IFACE:-1}" = 1 ]; then
        hl_rename_netdev "$iface" "$iface_want" && iface="$iface_want"
    fi

    # ---- стадия 4: подсеть модема
    # Порядок важен: сначала принять то, что есть, и только если подсеть
    # занята или заводская — переопределять. Свежий HiLink сидит на
    # 192.168.8.1, и такой он у всей партии: без разведения по своим
    # подсетям больше одного модема на хосте работать не может.
    if [ "$family" = hilink ]; then
        hl_hilink_provision "$slot" "$iface" "$port" >/dev/null 2>&1 || true
    fi

    # ---- стадия 5: адресация и маршруты
    if hl_subnet_conflict "$slot" "$iface"; then
        report conflict "подсеть занята другим интерфейсом" "$iface"; return
    fi
    hl_addr_configure "$slot" "$iface" || { report noaddr "адресация не встала" "$iface"; return; }

    # ---- стадия 6: соединение через веб-API
    if [ "$family" = hilink ]; then
        hl_hilink_ensure_connected "$slot" >/dev/null 2>&1
        # IMEI узнаётся только отсюда: в USB-дескрипторе HiLink
        # отдаёт SerialNumber=0. Нужен для переносимых пинов.
        [ -z "$(hl_imei_get "$port")" ] &&
            hl_imei_set "$port" "$(hl_hilink_imei "$slot" 2>/dev/null)"
    fi

    # ---- стадия 6: здоровье
    # Проверки стоят секунд, поэтому по расписанию, а не каждый цикл.
    # Исключения: модем уже в неудачах, либо запрошен --full.
    local hc_file="$HL_VAR/hc.$slot" hs_file="$HL_VAR/hs.$slot"
    local last fails due reason
    last=$(cat "$hc_file" 2>/dev/null || echo 0)
    fails=$(hl_fail_count "$slot")
    due=0
    [ "$FORCE_HEALTH" = 1 ] && due=1
    [ "$fails" -gt 0 ] 2>/dev/null && due=1
    [ $((NOW - last)) -ge "$HL_HEALTH_INTERVAL" ] 2>/dev/null && due=1

    if [ "$due" != 1 ]; then
        reason=$(cat "$hs_file" 2>/dev/null || echo "")
        if [ -z "$reason" ]; then report ok "$have_drv" "$iface"
        else report fail "$reason (кэш)" "$iface"; fi
        return
    fi

    hl_check_driver_fix "$iface" >/dev/null 2>&1
    reason=$(hl_health_reason "$slot" "$iface")
    echo "$NOW" >"$hc_file"

    if [ -z "$reason" ]; then
        hl_fail_clear "$slot"; : >"$hs_file"
        # Счётчики грубых операций сбрасываются ТОЛЬКО здесь, по факту
        # успеха. Иначе перебор конфигураций и re-enumerate зацикливаются.
        hl_cnt_clear reenum "$port"; hl_cnt_clear cfg "$port"
        report ok "$have_drv" "$iface"
    else
        local n; n=$(hl_fail_bump "$slot")
        printf '%s\n' "$reason" >"$hs_file"
        warn "слот $slot ($iface): $reason [неудача $n]"
        [ "$DO_RECOVER" = 1 ] && [ "$HL_WATCHDOG_ENABLE" = 1 ] &&
            hl_recover "$slot" "$iface" "$port" "$n"
        report fail "$reason" "$iface"
    fi
}

PAR=$(hl_parallelism)
dbg "обрабатываю $TOTAL модемов в $PAR потоков"

running=0
for spec in "${DEVS[@]}"; do
    worker "$spec" &
    running=$((running + 1))
    if [ "$running" -ge "$PAR" ]; then
        if wait -n 2>/dev/null; then :; else wait; running=0; continue; fi
        running=$((running - 1))
    fi
done
wait

# ============================================================ фаза 3 ========

cat "$WORKDIR"/* 2>/dev/null | sort -n >"$SNAP"
rm -rf "$WORKDIR"

ok=$(awk -F'\t' '$4=="ok"' "$SNAP" 2>/dev/null | wc -l)
bad=$((TOTAL - ok))

# Осиротевшие правила и таблицы: модем переткнули, номер сменился,
# а старое правило осталось бы перехватывать чужой трафик.
[ -z "$ONLY_SLOT" ] && hl_gc_orphans "$(awk -F'\t' '{print $1}' "$SNAP" 2>/dev/null | tr '\n' ' ')"

date +%s >"$HL_RUN/last-run"
info "цикл завершён: найдено $TOTAL, в норме $ok, с проблемами $bad (потоков $PAR)"

exit 0
