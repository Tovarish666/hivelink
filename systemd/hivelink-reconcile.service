[Unit]
Description=hivelink — цикл приведения USB-модемов в рабочее состояние
Documentation=https://github.com/Tovarish666/hivelink
After=network.target
Wants=network.target

# Шторм udev при включении сорока модемов запускает юнит десятки раз подряд.
# С обычным start-limit systemd после пятого запуска объявляет юнит
# сбойным и перестаёт его трогать вообще — ферма остаётся ненастроенной.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=oneshot
ExecStart=/opt/hivelink/sbin/hivelink-reconcile

# Цикл идемпотентен; неуспех отдельного модема не должен ронять юнит,
# иначе systemd перестанет запускать его по таймеру.
SuccessExitStatus=0 1
TimeoutStartSec=900

Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
