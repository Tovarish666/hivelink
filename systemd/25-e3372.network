# Модемные интерфейсы E3372/K5160: DHCP от самого модема, полная изоляция
# от резолвинга и от таблицы маршрутизации хоста.
#
# Матч ТОЛЬКО по драйверу. По имени и MAC матчить нельзя: у всех E3372 в
# прошивке зашит один и тот же MAC (0c:5b:8f:xx:xx:xx у целых партий), поэтому
# systemd переименовывает первый интерфейс в enx<mac>, а остальные оставляет
# ядерными eth0..ethN. Драйвер — единственный надёжный признак.
#
# huawei_cdc_ncm/cdc_mbim здесь намеренно НЕ перечислены: это raw-IP режим без
# DHCP-сервера на той стороне. Такие устройства драйвер переводит на другую
# USB-конфигурацию, а не пытается настроить.

[Match]
Driver=cdc_ether rndis_host

[Link]
# Модем не должен участвовать в network-online.target: иначе загрузка хоста
# ждёт сорок интерфейсов, часть которых поднимется через минуту.
RequiredForOnline=no

[Network]
DHCP=ipv4
LinkLocalAddressing=no
IPv6AcceptRA=no
LLDP=no
EmitLLDP=no
# Резолвинг хоста модемы не трогают ни при каких условиях.
DNS=
DNSDefaultRoute=no

[DHCPv4]
UseDNS=no
UseDomains=no
UseNTP=no
UseHostname=no
UseTimezone=no
# Шлюз и маршруты из DHCP не берём: иначе сорок default route подерутся с
# маршрутом хоста. Маршрутизация делается в отдельных таблицах драйвером.
UseGateway=false
UseRoutes=false
RouteMetric=1000
# Все модемы шлют один и тот же MAC — идентификатор клиента берём не из него.
ClientIdentifier=duid
