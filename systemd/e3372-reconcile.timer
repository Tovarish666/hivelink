[Unit]
Description=e3372 reconcile каждые 15с (страховка поверх udev-триггера)

[Timer]
# udev даёт мгновенную реакцию на появление устройства. Таймер нужен для того,
# что udev-событием не сопровождается: модем ответил, но не дозвонился; DHCP
# не доехал; модем отвалился без события; конфигурацию надо перебирать шагами.
OnBootSec=20
OnUnitActiveSec=15
AccuracySec=2s
# Не догонять пропущенные запуски после простоя — состояние всё равно свежее.
Persistent=false

[Install]
WantedBy=timers.target
